{
  "$schema": "./watchconfig.schema.json",
  "settings": {
    "debounceMs": 1000
  },
  "env": {
    "path:projects": "/src/projects",
    "path:azure": "/src/azure",
    "path:webui2": "/src/projects/BrightMetricsWeb/BrightMetricsWeb.BrightMetricsWebUI/UI-2"
  },
  "hooks": {
    "onStartup": [
      {
        "name": "Azurite",
        "command": "azurite --silent --location ./.startup-content/azurite/workspace"
      },
      {
        "name": "IIS Express",
        "command": "pwsh -ExecutionPolicy Bypass -NoProfile -File ./Scripts/Start-IIS.ps1 -ServerDirectory {{path:azure}}/BrightMetricsWeb"
      },
      {
        "name": "TypeScript Watcher",
        "command": "npx --prefix {{path:webui2}}/ -- tsc -w -p {{path:webui2}}/tsconfig.development.json --pretty false --preserveWatchOutput"
      },
      {
        "name": "Web Logs",
        "command": "pwsh -ExecutionPolicy Bypass -NoProfile -File ./Scripts/Watch-WebLogs.ps1"
      },
      {
        "name": "CAWJ",
        "command": "dotnet run --project {{path:projects}}/BrightMetricsWeb/CloudAgentWebJob/CloudAgentWebJob.csproj"
      },
      {
        "name": "Trigger Login (deprecated)",
        "command": "pwsh -ExecutionPolicy Bypass -NoProfile -File ./Scripts/Start-SamlLogin.ps1",
        "enabled": false
      },
      {
        "name": "Trigger Login",
        "command": "pwsh -ExecutionPolicy Bypass -NoProfile -File ./Scripts/Start-WebApp.ps1"
      },
      {
        "name": "PC RT",
        "command": "dotnet run --project {{path:projects}}/BrightMetricsWeb/PureCloudRealtime/PureCloudRealtime.csproj",
        "enabled": false
      }
    ],
    "onUpdate": [
      {
        "name": "Lint Typescript",
        "source": "{{path:webui2}}/scripts/build/brightmetrics.js",
        "location": "{{path:webui2}}/",
        "command": "npm run lint --silent && echo OK",
        "enabled": false
      },
      {
        "name": "Copy JS to Server",
        "source": "{{path:webui2}}/scripts/build/brightmetrics.js",
        "copyTo": "{{path:azure}}/BrightmetricsWeb/UI-2/scripts/build/brightmetrics.js"
      }
    ]
  }
}
