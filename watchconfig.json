{
  "$schema": "./watchconfig.schema.json",
  "settings": {
    "debounceMs": 1000
  },
  "env": {
    "path:projects": "/src/projects",
    "path:azure": "/src/azure",
    "path:webui": "/src/projects/BrightMetricsWeb/BrightMetricsWeb.BrightMetricsWebUI",
    "path:webui2": "/src/projects/BrightMetricsWeb/BrightMetricsWeb.BrightMetricsWebUI/UI-2"
  },
  "hooks": {
    "onStartup": [
      {
        "name": "Kill Existing Azurite",
        "command": "pwsh -ExecutionPolicy Bypass -NoProfile -File ./Scripts/Kill-Azurite.ps1",
        "job": "kill_previous_azurite"
      },
      {
        "name": "Azurite",
        "command": "bun run azurite",
        "await": "kill_previous_azurite"
      },
      {
        "name": "Restore NuGet Packages",
        "command": "pwsh -ExecutionPolicy Bypass -NoProfile -File {{path:projects}}/Invoke-Build.ps1 -Restore",
        "job": "restore_nuget_packages"
      },
      {
        "name": "CAWJ",
        "command": "dotnet run --project {{path:projects|winstyle}}/BrightMetricsWeb/CloudAgentWebJob/CloudAgentWebJob.csproj",
        "await": "restore_nuget_packages"
      },
      {
        "name": "PC RT",
        "command": "dotnet run --project {{path:projects|winstyle}}/BrightMetricsWeb/PureCloudRealtime/PureCloudRealtime.csproj",
        "await": "restore_nuget_packages",
        "logLevel": "Silent",
        "enabled": false
      },
      {
        "name": "Build WebUI",
        "command": "pwsh -ExecutionPolicy Bypass -NoProfile -File ./Scripts/Invoke-MSBuild.ps1 -Project {{path:webui|winstyle}}/BrightMetricsWeb.BrightMetricsWebUI.csproj /p:INVOKE_BUILD_VERBOSITY=0",
        "notes": "This runs MSBuild tasks that copy all web files over to the directory served by IIS",
        "job": "build_webui"
      },
      {
        "name": "TypeScript Watcher",
        "command": "npx --prefix {{path:webui2}}/ -- tsc -w -p {{path:webui2}}/tsconfig.development.json --pretty false --preserveWatchOutput",
        "await": "build_webui"
      },
      {
        "name": "IIS Express",
        "command": "pwsh -ExecutionPolicy Bypass -NoProfile -File ./Scripts/Start-IIS.ps1 -ServerDirectory {{path:azure|winstyle}}/BrightMetricsWeb",
        "logLevel": "Silent",
        "await": "build_webui"
      },
      {
        "name": "Web Logs",
        "command": "pwsh -ExecutionPolicy Bypass -NoProfile -File ./Scripts/Watch-WebLogs.ps1",
        "notes": "Pipes ASP.NET logs to stdout",
        "enabled": false
      },
      {
        "name": "Web Logs Info",
        "command": "echo WebLogs written to %TMP%\\bmweblog2.txt",
        "job": "web_logs_2",
        "enabled": true
      },
      {
        "name": "Trigger Login",
        "command": "pwsh -ExecutionPolicy Bypass -NoProfile -File ./Scripts/Start-WebApp.ps1",
        "await": "web_logs_2"
      }
    ],
    "onUpdate": [
      {
        "name": "Lint TS/JS",
        "source": "{{path:webui2}}/scripts/build/brightmetrics.js",
        "location": "{{path:webui2}}/",
        "command": "npm run lint --silent && echo OK",
        "enabled": false
      },
      {
        "name": "Copy JS to Server",
        "source": "{{path:webui2}}/scripts/build/brightmetrics.js",
        "copyTo": "{{path:azure}}/BrightmetricsWeb/UI-2/scripts/build/brightmetrics.js"
      },
      {
        "name": "Copy CSS to Server",
        "source": "{{path:webui2}}/styles/build/brightmetrics.css",
        "copyTo": "{{path:azure}}/BrightmetricsWeb/UI-2/styles/build/brightmetrics.css"
      }
    ]
  }
}
